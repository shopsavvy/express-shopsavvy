{
  "name": "express-shopsavvy",
  "version": "1.0.0",
  "description": "Express.js middleware for ShopSavvy product search and price comparison",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@shopsavvy/sdk": "^1.3.0"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.3",
    "express": "^4.18.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "express",
    "shopsavvy",
    "price-comparison",
    "middleware"
  ],
  "license": "MIT",
  "author": "ShopSavvy by Monolith Technologies, Inc.",
  "homepage": "https://shopsavvy.com/integrations/express",
  "repository": {
    "type": "git",
    "url": "https://github.com/shopsavvy/express-shopsavvy"
  }
}
